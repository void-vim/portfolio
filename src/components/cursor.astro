<div id="custom-cursor" class="cursor hidden"></div>

<style>
  .cursor {
    position: fixed;
    top: 0;
    left: 0;
    width: 16px;
    height: 16px;
    background-color: var(--foreground, #ffffff); 
    mix-blend-mode: difference;
    pointer-events: none;
    user-select: none;
    z-index: 9999;
    will-change: transform;
  }

  .hidden {
    display: none;
  }
</style>

<script>
  let cursorAnimationId = null;
  let mouseMoveHandler = null;
  let mouseOverHandler = null;
  let mouseOutHandler = null;

  const initCursor = () => {
    const cursor = document.getElementById("custom-cursor");
    const isDesktop = window.matchMedia("(min-width: 1024px)").matches;

    if (!isDesktop || !cursor) {
      if (cursor) cursor.classList.add("hidden");
      return;
    }

    cursor.classList.remove("hidden");

    // Clean up previous listeners/animations if re-initializing
    if (cursorAnimationId) cancelAnimationFrame(cursorAnimationId);
    if (mouseMoveHandler) window.removeEventListener("mousemove", mouseMoveHandler);
    if (mouseOverHandler) document.removeEventListener("mouseover", mouseOverHandler);
    if (mouseOutHandler) document.removeEventListener("mouseout", mouseOutHandler);

    // Initialize to center of screen to avoid 0,0 flashes
    let mouse = { x: window.innerWidth / 2, y: window.innerHeight / 2 };
    let cursorP = { x: window.innerWidth / 2, y: window.innerHeight / 2 };

    let moveTimer = null;
    const MOVING_SCALE = 1.8;
    const RESTING_SCALE = 1;
    let targetScale = RESTING_SCALE;
    let currentScale = RESTING_SCALE;

    const setScaleTarget = (scale) => {
      targetScale = scale;
    };

    const handleMove = () => {
      setScaleTarget(MOVING_SCALE);

      if (moveTimer) window.clearTimeout(moveTimer);
      moveTimer = window.setTimeout(() => {
        setScaleTarget(RESTING_SCALE);
      }, 200);
    };

    mouseMoveHandler = (e) => {
      mouse.x = e.clientX;
      mouse.y = e.clientY;
      handleMove();
    };

    mouseOverHandler = (e) => {
      if (e.target?.closest(".link")) {
        setScaleTarget(targetScale * 0.5);
      }
    };

    mouseOutHandler = (e) => {
      if (e.target?.closest(".link")) {
        setScaleTarget(currentScale / 0.5);
      }
    };

    window.addEventListener("mousemove", mouseMoveHandler);
    document.addEventListener("mouseover", mouseOverHandler);
    document.addEventListener("mouseout", mouseOutHandler);

    const tick = () => {
      cursorP.x += (mouse.x - cursorP.x) * 0.15;
      cursorP.y += (mouse.y - cursorP.y) * 0.15;

      currentScale += (targetScale - currentScale) * 0.15;

      cursor.style.transform = `translate3d(${cursorP.x - 8}px, ${cursorP.y - 8}px, 0) scale(${currentScale})`;

      cursorAnimationId = requestAnimationFrame(tick);
    };

    cursorAnimationId = requestAnimationFrame(tick);
  };

  // Run on load and after Astro page transitions
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initCursor);
  } else {
    initCursor();
  }

  document.addEventListener("astro:after-swap", initCursor);
</script>
