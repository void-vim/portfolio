---
import { Network, FolderGit2, Feather, Cpu } from '@lucide/astro';

const DATA = [
  { 
    name: "connect", 
    icon: Network, 
    description: "Reach Out" 
  },
  { 
    name: "project", 
    icon: FolderGit2, 
    description: "Recent Builds" 
  },
  { 
    name: "blog", 
    icon: Feather, 
    description: "Read my thoughts" 
  },
  { 
    name: "uses", 
    icon: Cpu, 
    description: "Gear Setup" 
  }
];
---
<ul class="ul-none">
  {DATA.map(({ name, icon: Ico, description }) => (
    <li>
      <a class="a-none" href={`/${name}`} title={description}>
        <Ico size={120} strokeWidth={1} />
        <span>
        <p class="name">{name}</p>
        <p class="desc">{description}</p>
        </span>
      </a>
    </li>
  ))}
</ul>

<style>
  ul {
    display: flex;
    justify-content: space-evenly;
    flex-wrap:wrap;
    gap: 3rem;
  }
  a {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    align-items: center;
    text-align: center;
    text-transform: uppercase;
  }
  .name {
    margin: 0;
  }
  .desc {
    margin: 0;
    font-size: 0.85rem;
    text-transform: none;
    color: var(--foreground-muted);
    text-transform: uppercase;
  }
  li :global(svg *) {
    stroke-width: 2px;
    vector-effect: non-scaling-stroke;
  }
</style>
